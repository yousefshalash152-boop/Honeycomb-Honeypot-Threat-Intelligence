<group name="cowrie,honeypot,">
  <rule id="100201" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.session.connect$</field>
    <description>Cowrie Honeypot: new connection</description>
  </rule>
  <rule id="100202" level="5">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie Honeypot: failed login attempt</description>
  </rule>
  <rule id="100203" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie Honeypot: successful login</description>
  </rule>
  <rule id="100204" level="7">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie Honeypot: command executed</description>
  </rule>
  <rule id="100205" level="10">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.session.file_download$</field>
    <description>Cowrie Honeypot: file download attempt</description>
  </rule>
</group>
